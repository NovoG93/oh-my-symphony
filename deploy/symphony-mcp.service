[Unit]
Description=symphony-mcp Streamable HTTP MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SYMPHONY_MCP_HOST=0.0.0.0
Environment=SYMPHONY_MCP_PORT=8080
Environment=SYMPHONY_BASE_URL=http://127.0.0.1:9999
Environment=SYMPHONY_MCP_TOKEN_FILE=/home/symphony/.config/symphony-mcp/token
Environment=SYMPHONY_MCP_ALLOWED_PROJECTS=oh-my-symphony
ExecStart=/home/symphony/oh-my-symphony/.venv/bin/symphony-mcp
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
